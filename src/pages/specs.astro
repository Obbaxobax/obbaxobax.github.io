---
import Layout from "../layouts/Layout.astro";

---

<Layout>
<div class="h-fit sm:h-full w-[99%] mb-8 mx-auto mt-2 flex flex-col items-center">
    <div class="flex flex-col items-center my-4">
		<h1
			class="w-fit p-2 bg-black bg-opacity-10 text-7xl font-medium rounded-t-md"
		>
			My Specs
		</h1>
		<div
			class="p-4 bg-black bg-opacity-10 rounded-md"
		>
			<p class="text-sm sm:text-4xl" style="font-family: heebo;">
				AMD Ryzen 5 7600X <br>
                MSI PRO B650M-A <br>
                G.SKILL Flare X5 32GB DDR5 <br>
                GeForce RTX 5060 Ti 16 Gigs <br>
                Corsair 3500X ARGB Mid-Tower Computer Case <br>
                Corsair RMe Series RM850e <br>
			</p>
		</div>
	</div>
</div>